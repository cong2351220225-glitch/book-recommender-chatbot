# Tệp cấu hình môi trường mẫu (.env.example)
# Sao chép tệp này thành .env và điền giá trị thực của bạn.
# TUYỆT ĐỐI KHÔNG commit tệp .env thật lên GitHub.

# ============================================================
# Google Gemini API Key (Bắt buộc)
# Lấy khóa miễn phí tại: https://aistudio.google.com/
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Khóa bí mật ký JSON Web Token (JWT)
# Thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
# ============================================================
JWT_SECRET_KEY=supersecretkeyforlibraryauth2026

# ============================================================
# Đường dẫn thư mục lưu trữ ChromaDB Vector Database
# ============================================================
CHROMA_PATH=chroma_db

# ============================================================
# Cổng lắng nghe của máy chủ FastAPI (mặc định: 8000)
# ============================================================
PORT=8000

# ============================================================
# (Tùy chọn) SerpApi Key — dùng cho tính năng AI Crawler
# Đăng ký tại: https://serpapi.com/
# ============================================================
SERPAPI_API_KEY=your_serpapi_key_here
