from __future__ import annotations

from typing import Any
from pydantic import BaseModel, Field


class CrawlSearchRequest(BaseModel):
    query: str = Field(..., min_length=1, description="Keywords or ISBN to search for")
    source: str = Field("all", description="Source to search: all, openlibrary, google_books, gutenberg, internet_archive, europeana, itunes")
    limit: int = Field(10, ge=1, le=50, description="Max results per source")


class CrawlBookCandidate(BaseModel):
    title: str = ""
    author: str = ""
    isbn: str = ""
    publisher: str = ""
    year: Any = None
    pages: Any = None
    language: str = ""
    description: str = ""
    cover_url: str = ""
    reading_available: Any = False
    reading_type: str = ""
    reading_url: str = ""
    source: str = ""
    is_duplicate: bool = False
    matched_by: str = ""
    matched_book_id: str = ""
    genre: str = ""
    tags: str = ""
    target_audience: str = ""
    mood: str = ""
    difficulty: str = ""
    summary: str = ""
    local_file: str = ""
    purchase_url: str = ""
    library_url: str = ""
    rating: Any = None
    featured: Any = False
    format: str = ""


class CrawlSearchResponse(BaseModel):
    query: str
    source: str
    total_found: int
    results: list[dict[str, Any]]


class CrawlImportRequest(BaseModel):
    candidate: dict[str, Any] = Field(..., description="Normalized book record to import into library")
    upsert_chroma: bool = Field(True, description="Whether to ingest new vector into ChromaDB immediately")


class CrawlImportResponse(BaseModel):
    success: bool
    message: str
    book_id: str | None = None
    vector_indexed: bool = False


class SyncChromaResponse(BaseModel):
    success: bool
    synced_count: int
    total_unindexed: int
    message: str

